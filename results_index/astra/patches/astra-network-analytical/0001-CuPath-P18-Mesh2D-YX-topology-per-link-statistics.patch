diff --git a/include/astra-network-analytical/congestion_aware/Mesh2D.h b/include/astra-network-analytical/congestion_aware/Mesh2D.h
new file mode 100644
index 0000000..281246a
--- /dev/null
+++ b/include/astra-network-analytical/congestion_aware/Mesh2D.h
@@ -0,0 +1,49 @@
+/******************************************************************************
+This source code is licensed under the MIT license found in the
+LICENSE file in the root directory of this source tree.
+*******************************************************************************/
+
+#pragma once
+
+#include "common/Type.h"
+#include "congestion_aware/BasicTopology.h"
+
+using namespace NetworkAnalytical;
+
+namespace NetworkAnalyticalCongestionAware {
+
+/**
+ * Mesh2D (CuPath P18 patch) implements a k x k 2D mesh without wrap-around.
+ * NPU t (t = x + k * y) is attached to router device k*k + t through an
+ * endpoint link; routers are connected to their 4 neighbours.
+ * Routing is dimension-order, Y first then X.
+ *
+ * Router-to-router links use the given bandwidth and latency. Endpoint links
+ * use the same bandwidth and the latency in env ASTRA_MESH_EP_LATENCY
+ * (default 0).
+ */
+class Mesh2D final : public BasicTopology {
+  public:
+    /**
+     * Constructor.
+     *
+     * @param npus_count number of npus, must be a square (k * k)
+     * @param bandwidth bandwidth of link
+     * @param latency latency of a router-to-router link
+     */
+    Mesh2D(int npus_count, Bandwidth bandwidth, Latency latency) noexcept;
+
+    /**
+     * Implementation of route function in Topology.
+     */
+    [[nodiscard]] Route route(DeviceId src, DeviceId dest) const noexcept override;
+
+  private:
+    /// mesh side length k
+    int side;
+
+    /// router device id of npu t
+    [[nodiscard]] DeviceId router_of(DeviceId npu) const noexcept;
+};
+
+}  // namespace NetworkAnalyticalCongestionAware
