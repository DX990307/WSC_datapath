diff --git a/congestion_aware/basic-topology/Mesh2D.cpp b/congestion_aware/basic-topology/Mesh2D.cpp
new file mode 100644
index 0000000..add4707
--- /dev/null
+++ b/congestion_aware/basic-topology/Mesh2D.cpp
@@ -0,0 +1,78 @@
+/******************************************************************************
+This source code is licensed under the MIT license found in the
+LICENSE file in the root directory of this source tree.
+*******************************************************************************/
+
+#include "congestion_aware/Mesh2D.h"
+#include <cassert>
+#include <cmath>
+#include <cstdlib>
+
+using namespace NetworkAnalyticalCongestionAware;
+
+Mesh2D::Mesh2D(const int npus_count, const Bandwidth bandwidth, const Latency latency) noexcept
+    : BasicTopology(npus_count, 2 * npus_count, bandwidth, latency) {
+    assert(npus_count > 0);
+    assert(bandwidth > 0);
+    assert(latency >= 0);
+
+    side = static_cast<int>(std::lround(std::sqrt(npus_count)));
+    assert(side * side == npus_count);
+
+    basic_topology_type = TopologyBuildingBlock::Mesh2D;
+
+    // endpoint link latency
+    auto ep_latency = Latency(0);
+    if (const char* env = std::getenv("ASTRA_MESH_EP_LATENCY")) {
+        ep_latency = std::atof(env);
+    }
+
+    // npu <-> its router
+    for (auto t = 0; t < npus_count; t++) {
+        connect(t, router_of(t), bandwidth, ep_latency, true);
+    }
+
+    // router <-> right and lower neighbours
+    for (auto y = 0; y < side; y++) {
+        for (auto x = 0; x < side; x++) {
+            const auto t = x + side * y;
+            if (x + 1 < side) {
+                connect(router_of(t), router_of(t + 1), bandwidth, latency, true);
+            }
+            if (y + 1 < side) {
+                connect(router_of(t), router_of(t + side), bandwidth, latency, true);
+            }
+        }
+    }
+}
+
+DeviceId Mesh2D::router_of(const DeviceId npu) const noexcept {
+    return npus_count + npu;
+}
+
+Route Mesh2D::route(DeviceId src, DeviceId dest) const noexcept {
+    // assert npus are in valid range
+    assert(0 <= src && src < npus_count);
+    assert(0 <= dest && dest < npus_count);
+
+    auto route = Route();
+    route.push_back(devices[src]);
+
+    // Y first, then X
+    auto x = src % side;
+    auto y = src / side;
+    const auto dx = dest % side;
+    const auto dy = dest / side;
+    route.push_back(devices[router_of(x + side * y)]);
+    while (y != dy) {
+        y += (dy > y) ? 1 : -1;
+        route.push_back(devices[router_of(x + side * y)]);
+    }
+    while (x != dx) {
+        x += (dx > x) ? 1 : -1;
+        route.push_back(devices[router_of(x + side * y)]);
+    }
+
+    route.push_back(devices[dest]);
+    return route;
+}
