 using namespace NetworkAnalytical;
 using namespace NetworkAnalyticalCongestionAware;
 
 // declaring static event_queue
 std::shared_ptr<EventQueue> Link::event_queue;
+std::vector<Link*> Link::all_links;
+
+namespace {
+EventTime link_window() noexcept {
+    static const EventTime window = [] {
+        const char* env = std::getenv("ASTRA_LINK_WINDOW");
+        return env ? static_cast<EventTime>(std::atoll(env)) : EventTime(0);
+    }();
+    return window;
+}
+}  // namespace
 
 void Link::link_become_free(void* const link_ptr) noexcept {
     assert(link_ptr != nullptr);
@@ -42,6 +56,7 @@ Link::Link(const Bandwidth bandwidth, const Latency latency) noexcept
       latency(latency),
       pending_chunks(),
       busy(false) {
+    all_links.push_back(this);
     assert(bandwidth > 0);
     assert(latency >= 0);
 
@@ -55,6 +70,10 @@ void Link::send(std::unique_ptr<Chunk> chunk) noexcept {
     if (busy) {
         // link is busy, add to pending chunks
         pending_chunks.push_back(std::move(chunk));
+        pending_since.push_back(Link::event_queue->get_current_time());
+        if (pending_chunks.size() > stat_max_queue) {
+            stat_max_queue = pending_chunks.size();
+        }
     } else {
         // service this chunk immediately
         schedule_chunk_transmission(std::move(chunk));
@@ -68,6 +87,8 @@ void Link::process_pending_transmission() noexcept {
     // get chunk to process
     auto chunk = std::move(pending_chunks.front());
     pending_chunks.pop_front();
+    stat_wait += Link::event_queue->get_current_time() - pending_since.front();
+    pending_since.pop_front();
 
     // service this chunk
     schedule_chunk_transmission(std::move(chunk));
@@ -129,7 +150,49 @@ void Link::schedule_chunk_transmission(std::unique_ptr<Chunk> chunk) noexcept {
 
     // schedule link free time
     const auto serialization_time = serialization_delay(chunk_size);
+    stat_chunks++;
+    stat_bytes += chunk_size;
+    record_busy(current_time, serialization_time);
     const auto link_free_time = current_time + serialization_time;
     auto* const link_ptr = static_cast<void*>(this);
     Link::event_queue->schedule_event(link_free_time, link_become_free, link_ptr);
 }
+
+void Link::set_ends(const DeviceId src, const DeviceId dst) noexcept {
+    src_id = src;
+    dst_id = dst;
+}
+
+void Link::record_busy(const EventTime start, const EventTime duration) noexcept {
+    stat_busy += duration;
+    const auto window = link_window();
+    if (window == 0 || duration == 0) {
+        return;
+    }
+    auto t = start;
+    const auto end = start + duration;
+    while (t < end) {
+        const auto w = t / window;
+        const auto w_end = std::min(end, (w + 1) * window);
+        if (stat_window_busy.size() <= w) {
+            stat_window_busy.resize(w + 1, 0);
+        }
+        stat_window_busy[w] += w_end - t;
+        t = w_end;
+    }
+}
+
+void Link::dump_stats(const std::string& path) noexcept {
+    std::ofstream out(path);
+    out << "src,dst,chunks,bytes,busy,wait,max_queue,max_window_busy,end_time\n";
+    const auto now = Link::event_queue->get_current_time();
+    for (const auto* link : all_links) {
+        uint64_t max_window = 0;
+        for (const auto b : link->stat_window_busy) {
+            max_window = std::max(max_window, b);
+        }
+        out << link->src_id << "," << link->dst_id << "," << link->stat_chunks << "," << link->stat_bytes << ","
+            << link->stat_busy << "," << link->stat_wait << "," << link->stat_max_queue << "," << max_window << ","
+            << now << "\n";
+    }
+}
