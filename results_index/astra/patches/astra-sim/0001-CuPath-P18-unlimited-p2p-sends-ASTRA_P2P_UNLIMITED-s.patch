Date: Wed, 21 Oct 2026 16:08:42 -0400
Subject: [PATCH] CuPath P18: unlimited p2p sends (ASTRA_P2P_UNLIMITED),
 send_delay attr, message log, link stats dump

---
 .../analytical/common/CommonNetworkApi.cc     | 40 +++++++++++++++++++
 .../CongestionAwareNetworkApi.cc              |  1 +
 .../analytical/congestion_aware/main.cc       |  7 ++++
 .../include/common/CommonNetworkApi.hh        |  7 ++++
 astra-sim/workload/HardwareResource.cc        | 22 ++++++++--
 astra-sim/workload/Workload.cc                |  7 +++-
 extern/network_backend/analytical             |  2 +-
 7 files changed, 81 insertions(+), 5 deletions(-)

diff --git a/astra-sim/network_frontend/analytical/common/CommonNetworkApi.cc b/astra-sim/network_frontend/analytical/common/CommonNetworkApi.cc
index faf2061..6394469 100644
--- a/astra-sim/network_frontend/analytical/common/CommonNetworkApi.cc
+++ b/astra-sim/network_frontend/analytical/common/CommonNetworkApi.cc
@@ -5,6 +5,11 @@ LICENSE file in the root directory of this source tree.
 
 #include "common/CommonNetworkApi.hh"
 #include <cassert>
+#include <cstdlib>
+#include <fstream>
+#include <map>
+#include <memory>
+#include <tuple>
 
 using namespace AstraSim;
 using namespace AstraSimAnalytical;
@@ -20,6 +25,31 @@ int CommonNetworkApi::dims_count = -1;
 
 std::vector<Bandwidth> CommonNetworkApi::bandwidth_per_dim = {};
 
+namespace {
+// CuPath P18 patch: per-message log
+std::ofstream* msg_log() {
+    static std::unique_ptr<std::ofstream> log = [] {
+        const char* path = std::getenv("ASTRA_MSG_LOG");
+        if (path == nullptr) {
+            return std::unique_ptr<std::ofstream>();
+        }
+        auto out = std::make_unique<std::ofstream>(path);
+        *out << "src,dst,tag,bytes,send_time,arrival_time\n";
+        return out;
+    }();
+    return log.get();
+}
+std::map<std::tuple<int, int, int>, uint64_t> send_times;
+}  // namespace
+
+void CommonNetworkApi::record_send(const int tag,
+                                   const int src,
+                                   const int dst) noexcept {
+    if (msg_log() != nullptr) {
+        send_times[{tag, src, dst}] = event_queue->get_current_time();
+    }
+}
+
 void CommonNetworkApi::set_event_queue(
     std::shared_ptr<EventQueue> event_queue_ptr) noexcept {
     assert(event_queue_ptr != nullptr);
@@ -40,6 +70,16 @@ void CommonNetworkApi::process_chunk_arrival(void* args) noexcept {
     const auto [tag, src, dest, count, chunk_id] = *data;
     delete data;
 
+    if (auto* const log = msg_log()) {
+        const auto it = send_times.find({tag, src, dest});
+        if (it != send_times.end()) {
+            *log << src << "," << dest << "," << tag << "," << count << ","
+                 << it->second << "," << event_queue->get_current_time()
+                 << "\n";
+            send_times.erase(it);
+        }
+    }
+
     // search tracker
     auto& tracker = CommonNetworkApi::get_callback_tracker();
     const auto entry = tracker.search_entry(tag, src, dest, count, chunk_id);
diff --git a/astra-sim/network_frontend/analytical/congestion_aware/CongestionAwareNetworkApi.cc b/astra-sim/network_frontend/analytical/congestion_aware/CongestionAwareNetworkApi.cc
index b8303ce..a51f57c 100644
