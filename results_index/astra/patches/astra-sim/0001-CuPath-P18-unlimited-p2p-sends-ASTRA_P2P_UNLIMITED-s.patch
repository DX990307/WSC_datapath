@@ -72,6 +72,7 @@ int CongestionAwareNetworkApi::sim_send(void* const buffer,
         arg_ptr);
 
     // initiate transmission from src -> dst.
+    record_send(tag, src, dst);
     topology->send(std::move(chunk));
 
     // return
