+
     /**
      * Constructor.
      *
diff --git a/astra-sim/workload/HardwareResource.cc b/astra-sim/workload/HardwareResource.cc
index 9a50509..3419b27 100644
--- a/astra-sim/workload/HardwareResource.cc
+++ b/astra-sim/workload/HardwareResource.cc
@@ -6,8 +6,24 @@ LICENSE file in the root directory of this source tree.
 // TODO: HardwareResource.cc should be moved to the system layer.
 
 #include "astra-sim/workload/HardwareResource.hh"
+#include <cstdlib>
+#include <string>
 
 using namespace std;
+
+namespace {
+// CuPath P18 patch: with ASTRA_P2P_UNLIMITED=1, point-to-point sends are not
+// limited to one in flight per NPU (like recvs); collectives are unchanged.
+bool p2p_exempt(const shared_ptr<Chakra::FeederV3::ETFeederNode>& node) {
+    static const bool unlimited = [] {
+        const char* env = getenv("ASTRA_P2P_UNLIMITED");
+        return env != nullptr && string(env) == "1";
+    }();
+    return node->type() == ChakraProtoMsg::NodeType::COMM_RECV_NODE ||
+           (unlimited &&
+            node->type() == ChakraProtoMsg::NodeType::COMM_SEND_NODE);
+}
+}  // namespace
 using namespace AstraSim;
 using namespace Chakra;
 
@@ -48,7 +64,7 @@ void HardwareResource::occupy(
             // gpu_ops_node = node;
             gpu_ops_node.emplace(node->id());
         } else {
-            if (node->type() == ChakraNodeType::COMM_RECV_NODE) {
+            if (p2p_exempt(node)) {
                 return;
             }
             assert(num_in_flight_gpu_comm_ops == 0);
@@ -72,7 +88,7 @@ void HardwareResource::release(
             assert(num_in_flight_gpu_comp_ops == 0);
             this->gpu_ops_node.erase(node->id());
         } else {
-            if (node->type() == ChakraNodeType::COMM_RECV_NODE) {
+            if (p2p_exempt(node)) {
                 return;
             }
             --num_in_flight_gpu_comm_ops;
@@ -101,7 +117,7 @@ bool HardwareResource::is_available(
             if (num_in_flight_gpu_comm_ops == 0) {
                 return true;
             } else {
-                if (node->type() == ChakraNodeType::COMM_RECV_NODE) {
+                if (p2p_exempt(node)) {
                     return true;
                 }
                 if (num_in_flight_gpu_comm_ops == 0) {
diff --git a/astra-sim/workload/Workload.cc b/astra-sim/workload/Workload.cc
index 8b33979..e54e64f 100644
--- a/astra-sim/workload/Workload.cc
+++ b/astra-sim/workload/Workload.cc
@@ -411,7 +411,12 @@ void Workload::issue_send_comm(
     sehd->wlhd = new WorkloadLayerHandlerData;
     sehd->wlhd->node_id = node->id();
     sehd->event = EventType::PacketSent;
-    sys->front_end_sim_send(0, Sys::dummy_data, size, UINT8, dst, tag, &snd_req,
+    // CuPath P18 patch: optional delay before the send enters the network
+    const uint64_t delay =
+        node->has_attr("send_delay") ? node->get_attr<uint64_t>("send_delay")
+                                     : 0;
+    sys->front_end_sim_send(delay, Sys::dummy_data, size, UINT8, dst, tag,
+                            &snd_req,
                             Sys::FrontEndSendRecvType::NATIVE,
                             &Sys::handleEvent, sehd);
 }
