  "typed-filter-update-latency": 1,
  "typed-filter-update-width": 16,
  "prefetch-predictor-entries": 256,
  "remote-data-path-batch-lines": 8,
  "remote-data-path-batches": 64,
  "typed-filter-mode": "cuckoo",
